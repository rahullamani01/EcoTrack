# ==========================================
# Sanjay Ghodawat University (SGU) EcoTrack
# Environment Configuration Template
# Copy this file to `.env` and fill in real values.
# Never commit `.env`.
# ==========================================

# --- Core Server Runtime ---
PORT=3000
NODE_ENV=development

# --- Gemini Multimodal AI Integration ---
# Used server-side for EcoGuide AI and AI waste classification
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Host and Application URL ---
APP_URL="http://localhost:3000"

# --- Google Maps Platform ---
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# --- Transactional Email Delivery ---
# When unconfigured, activation codes are logged to the server console in dev.
RESEND_API_KEY=""
EMAIL_FROM="EcoTrack SGU <no-reply@sguk.ac.in>"

# --- Database Connection (MongoDB) ---
# Local MongoDB:   mongodb://127.0.0.1:27017/ecotrack
# Hosted Atlas:    mongodb+srv://<user>:<password>@<cluster>/ecotrack
# Leave empty to use the built-in file-backed engine (.data/*.json).
MONGODB_URI="mongodb://127.0.0.1:27017/ecotrack"

# --- Session & Security Secrets ---
SESSION_SECRET="GENERATE_A_RANDOM_SECRET"

# --- Demonstration Account Passwords ---
DEMO_FACULTY_PASSWORD="CHANGE_ME"
DEMO_ADMIN_PASSWORD="CHANGE_ME"
