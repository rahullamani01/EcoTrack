# Sanjay Ghodawat University (SGU) EcoTrack
# Environment Configuration Template (.env.example)
# ==========================================

# --- Core Server Runtime ---
PORT=3000
NODE_ENV=development

# --- Gemini Multimodal AI Integration ---
# Used server-side for EcoGuide AI conversational assistant and multimodal AI waste classification
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Host and Application URL ---
# Auto-populated in AI Studio Cloud Run preview, or your university production domain
APP_URL="https://ais-dev-o53fk6z6rh63qftrnhfwbh-667329511058.asia-southeast1.run.app"

# --- Google Maps Platform ---
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# --- Transactional Email Delivery (Phase 6) ---
# Configure Resend or SendGrid to dispatch real 6-digit student activation codes and event confirmations.
# When unconfigured, the application runs in development audit mode and logs codes to server console.
RESEND_API_KEY=""
EMAIL_FROM="EcoTrack SGU <no-reply@sguk.ac.in>"

# --- Database Connection (Optional Remote Persistence) ---
# The server includes an integrated ACID-compliant atomic persistent storage engine (.data/*.json).
# To bridge to a hosted MongoDB cluster, provide the connection string below:
MONGODB_URI=""

# --- Session & Security Secrets ---
SESSION_SECRET="GENERATE_A_RANDOM_SECRET"
